{
  "scripts": {
    "update-dashboard": "node -e 'const fs=require("fs");const content=fs.readFileSync("DASHBOARD.md","utf8");fs.writeFileSync("DASHBOARD.md",content.replace(/\$\((.*?)\)/g,(m,c)=>require("child_process").execSync(c).toString().trim()))'",
    "update-all": "npm run update-progress && npm run update-dashboard"
  }
}
