{
  "name": "step-towards-light",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "update-progress": "node scripts/update-progress.js",
    "monitor": "node scripts/monitoring/docker-health.js",
    "update-dashboard": "node scripts/update-dashboard.js",
    "update-all": "npm run update-progress && npm run update-dashboard",
    "docker:monitor": "node scripts/docker-monitoring/warp-docker-monitor.js",
    "docker:logs": "scripts/docker-monitoring/warp-commands.sh logs",
    "docker:stats": "scripts/docker-monitoring/warp-commands.sh stats",
    "docker:status": "scripts/docker-monitoring/warp-commands.sh status",
    "docker:events": "scripts/docker-monitoring/warp-commands.sh events",
    "docker:validate": "scripts/docker-monitoring/warp-commands.sh validate",
    "docker:all": "scripts/docker-monitoring/warp-commands.sh all",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "test:all": "npm test && npm run test:e2e",
    "monitor:load": "node scripts/monitor-load.js",
    "monitor:production": "npm run monitor:load && npm run test:all && npm run update-all",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ssl:generate": "mkdir -p config/nginx/certs && openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout config/nginx/certs/privkey.pem -out config/nginx/certs/fullchain.pem",
    "nginx:validate": "docker run --rm -v /Users/shazyasif/step-towards-light/config/nginx/nginx.conf:/etc/nginx/nginx.conf:ro nginx:latest nginx -t",
    "nginx:reload": "docker exec nginx-proxy nginx -s reload",
    "docs:update": "node scripts/docs/auto-update.js",
    "ai:init": "node scripts/ai/llama_integration.js",
    "ai:test": "node scripts/ai/test.js",
    "ai:analyze": "node -e 'require(\"./scripts/ai/llama_integration\").analyze(process.argv[1])'",
    "monitor:ai": "node scripts/ai/monitor-enhance.js",
    "monitor:continuous": "watch -n 300 npm run monitor:ai",
    "monitor:all": "npm run monitor:ai && npm run update-all",
    "ai:example": "node scripts/ai/example-usage.js",
    "ai:report": "node scripts/ai/generate-report.js",
    "test:ai": "jest tests/ai/ai.test.js",
    "test:ai:watch": "jest tests/ai/ai.test.js --watch",
    "test:ai:coverage": "jest tests/ai/ai.test.js --coverage",
    "ai:validate": "node scripts/ai/validate.js",
    "ai:report:daily": "node -e 'require(\"./scripts/ai/reporter\").generateDailyReport()'",
    "ai:alerts": "node -e 'console.log(require(\"./scripts/ai/alert-manager\").getActiveAlerts())'",
    "test:alerts": "jest tests/ai/alert-reporter.test.js",
    "ai:dashboard": "node scripts/ai/dashboard.js",
    "ai:dashboard:watch": "watch -n 300 npm run ai:dashboard",
    "test:dashboard": "jest tests/ai/dashboard.test.js"
  },
  "dependencies": {
    "csurf": "^1.11.0",
    "express-rate-limit": "^7.5.0",
    "next": "^14.0.0",
    "node-fetch": "^3.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.14",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.16",
    "babel-jest": "^29.7.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5"
  }
}
